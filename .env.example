# Keep this as simulated until you have authorized real-time OTD access.
TRACKING_MODE=simulated
APP_NAME=Delhi Transit Tracker API
LOG_LEVEL=INFO

# Required only when TRACKING_MODE=live and OTD has approved access.
# Never commit a real key or put it in a client-side app.
OTD_ACCESS_APPROVED=false
OTD_API_KEY=
OTD_FEED_URL=https://otd.delhi.gov.in/api/realtime/VehiclePositions.pb
OTD_REQUEST_TIMEOUT_SECONDS=10
DATABASE_PATH=data/transit.sqlite3
# Optional moderator-only report deletion credential. Do not expose to clients.
REPORTS_ADMIN_TOKEN=

# Attribution shown in /api/v1/meta.
DATA_ATTRIBUTION=Delhi Open Transit Data (OTD)
